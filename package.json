{
  "name": "tv-show-manager",
  "productName": "Torrent",
  "version": "1.3.3",
  "description": "Desktop TV show episode manager",
  "main": "dist-electron/main.js",
  "author": "Remco Groothoff",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --win -c.npmRebuild=false -c.win.signAndEditExecutable=false",
    "dist:dir": "vite build && electron-builder --win --dir -c.npmRebuild=false -c.win.signAndEditExecutable=false",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webtorrent": "1.9.7",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "@types/webtorrent": "^0.109.8"
  },
  "build": {
    "appId": "com.tv.manager",
    "productName": "Torrent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Torrent-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "remie1529",
        "repo": "TV-Show-Manager"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remie1529/TV-Show-Manager.git"
  }
}
