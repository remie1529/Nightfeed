{
  "name": "tv-show-manager",
  "productName": "Nightfeed",
  "version": "1.8.5",
  "description": "Desktop TV show and movie manager",
  "main": "dist-electron/main.js",
  "author": "Remco Groothoff",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --win -c.npmRebuild=false -c.win.signAndEditExecutable=false",
    "dist:dir": "vite build && electron-builder --win --dir -c.npmRebuild=false -c.win.signAndEditExecutable=false",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "basic-ftp": "^5.2.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "koffi": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webtorrent": "1.9.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/webtorrent": "^0.109.8",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.tv.manager",
    "productName": "Nightfeed",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nightfeed-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "remie1529",
        "repo": "Nightfeed"
      }
    ],
    "asarUnpack": [
      "dist-electron/search-worker.js",
      "dist-electron/torrent-utility.js",
      "dist-electron/metadata-worker.js",
      "**/*.node",
      "**/node_modules/webtorrent/**",
      "**/node_modules/@webtorrent/**",
      "**/node_modules/utp-native/**",
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**"
    ],
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remie1529/Nightfeed.git"
  }
}
